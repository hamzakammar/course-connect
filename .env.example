# Course Connect data pipeline — environment variables
# Copy this file to `.env` and fill in your own values. `.env` is gitignored;
# never commit a real key.

# UW Open Data API v3 key — used for LIVE seat counts (enrolled / capacity).
# Get a free key at: https://openapi.data.uwaterloo.ca/
# If this is unset, the pipeline still runs and simply omits seat fields.
UW_OPENDATA_KEY=
